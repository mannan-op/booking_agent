        64
      ],
      "id": "24382289-156f-415a-9515-d5fddc7f42e5",
      "name": "Research Battery Candidates"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || $input.first().json.output;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nif (!parsed.candidates || parsed.candidates.length === 0) {\n  return [{ json: { model: null, source: 'researched', note: 'no_candidates_found' } }];\n}\n\nreturn parsed.candidates.map(model => ({\n  json: { model, source: 'researched' }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
