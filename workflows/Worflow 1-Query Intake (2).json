        "query": "INSERT INTO conversations (\n    conversation_id,\n    channel,\n    customer_phone,\n    status\n)\nVALUES (\n    '{{ $('03 \u2014 Prepare Idempotency').item.json.conversation_id }}',\n    '{{ $('03 \u2014 Prepare Idempotency').item.json.channel }}',\n    '{{ $('03 \u2014 Prepare Idempotency').item.json.from }}',\n    'open'\n)\nON CONFLICT (conversation_id) DO UPDATE\nSET customer_phone = EXCLUDED.customer_phone\nRETURNING conversation_id;",
