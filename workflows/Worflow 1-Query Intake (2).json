    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const messageId = $json.message_id;\n\nif (!messageId) {\n  throw new Error('Missing message_id');\n}\n\nconst provided = $json.conversation_id;\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst conversationId = (typeof provided === 'string' && uuidRe.test(provided))\n  ? provided\n  : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n      const r = Math.random() * 16 | 0;\n      const v = c === 'x' ? r : (r & 0x3 | 0x8);\n      return v.toString(16);\n    });\n\nreturn {\n  json: {\n    ...$json,\n    conversation_id: conversationId,\n    idempotency_key: `${$json.channel}:${$json.from}:${messageId}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -624,
        96
      ],
