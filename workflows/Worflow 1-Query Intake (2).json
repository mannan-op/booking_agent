        "jsCode": "const json = $json;\nconst body = json.body && typeof json.body === 'object' ? json.body : {};\nconst message = Array.isArray(json.messages) ? json.messages[0] : null;\nconst image = message && message.image && typeof message.image === 'object' ? message.image : {};\nconst textFromMeta = (message && message.text && message.text.body) || image.caption || '';\nconst from = body.from || (message && message.from) || '';\nconst messageId = body.message_id || (message && message.id) || '';\nconst text = body.text || textFromMeta || '';\nconst imageUrl = body.image_url || image.id || image.link || '';\nconst contentType = (body.content_type === 'image' || Boolean(imageUrl) || (message && message.type === 'image'))\n  ? 'image'\n  : (body.content_type || 'text');\nreturn {\n  json: {\n    conversation_id: body.conversation_id || json.conversation_id || '',\n    channel: body.channel || 'whatsapp',\n    from,\n    message_id: messageId,\n    text,\n    image_url: imageUrl,\n    content_type: contentType,\n    source: message ? 'whatsapp' : 'webhook',\n  },\n};"
      },
