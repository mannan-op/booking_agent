      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst config = $('Select_From_Price_Config').first().json;\n\nconst sampleCount = Number(data.sample_size || 0);\nconst minSampleSize = Number(config.min_sample_size || 3);\n\nreturn [{\n  json: {\n    pricing_status: sampleCount >= minSampleSize ? \"resolved\" : \"unresolved\",\n    sample_count: sampleCount,\n    min_sample_size: minSampleSize,\n    prices: data.price ? [data.price] : [],\n    message: sampleCount >= minSampleSize\n      ? \"Enough valid price samples\"\n      : \"Not enough valid price samples\"\n  }\n}];"
