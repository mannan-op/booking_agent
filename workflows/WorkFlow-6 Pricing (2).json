    {
      "parameters": {
        "jsCode": "const salesData = $input.first().json;\nconst config = $('Select_From_Price_Config').first().json; // <-- yahan EXACT node name daalna\n\n// Weighted average: total revenue / total quantity\nlet totalRevenue = 0;\nlet totalQty = 0;\nsalesData.sales.forEach(sale => {\n  totalRevenue += sale.sale_price * sale.qty;\n  totalQty += sale.qty;\n});\n\nlet price = totalRevenue / totalQty;\n\nif (config.markup_percent) {\n  price = price * (1 + config.markup_percent / 100);\n}\n\nreturn [{\n  json: {\n    price: Math.round(price),\n    pricing_window_used: '90_day',\n    sample_size: salesData.sample_size\n  }\n}];"
      },
