    {
      "parameters": {
        "jsCode": "const salesData = $input.first().json;\nconst config = $('Select_From_Price_Config').first().json;\n\nconst prices = salesData.sales\n  .map(s => Number(s.sale_price))\n  .filter(p => !isNaN(p));\n\nlet price;\n\nif (config.formula_type === 'average') {\n  price = prices.reduce((sum, p) => sum + p, 0) / prices.length;\n} else if (config.formula_type === 'median') {\n  const sorted = [...prices].sort((a, b) => a - b);\n  const mid = Math.floor(sorted.length / 2);\n\n  price = sorted.length % 2 === 0\n    ? (sorted[mid - 1] + sorted[mid]) / 2\n    : sorted[mid];\n}\n\nif (config.markup_percent) {\n  price = price * (1 + Number(config.markup_percent) / 100);\n}\n\nreturn [{\n  json: {\n    product_id: salesData.product_id,\n    price: Math.round(price),\n    pricing_window_used: `${salesData.window_days}_day`,\n    sample_size: prices.length,\n    formula_used: config.formula_type,\n    markup_percent: Number(config.markup_percent)\n  }\n}];"
      },
