            {
              "id": "f62fa517-5020-412c-b6f3-08860f91b931",
              "leftValue": "={{ $json.output.confidence }}",
              "rightValue": "={{ 0.8 }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
