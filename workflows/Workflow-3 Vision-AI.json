              "name": "image_url"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -200,
        288
      ],
      "id": "wf3-exec-trigger-voltops",
      "name": "When Executed by WF1"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nlet vision = {};\ntry {\n  vision = $('Parse Code in js').first().json.output || {};\n} catch (e) {\n  vision = item.output || {};\n}\nlet picture = {};\ntry {\n  picture = $('Picture of battery given by user').first().json || {};\n} catch (e) {\n  picture = item;\n}\nconst confidence = Number(vision.confidence);\nconst model = vision.likely_model || null;\nconst extracted = vision.extracted_text || null;\nconst safeConfidence = Number.isFinite(confidence) ? confidence : 0;\nconst reply = \"Thanks for the photo. We could not read the battery model clearly, so a teammate will review it and reply shortly.\";\nreturn [{\n  json: {\n    conversation_id: picture.conversation_id || item.conversation_id || \"\",\n    channel: picture.channel || item.channel || \"whatsapp\",\n    text: picture.text || item.text || \"\",\n    image_url: picture.image_url || item.image_url || \"\",\n    confidence: safeConfidence,\n    likely_model: model,\n    model,\n    extracted_text: extracted,\n    notes: vision.notes || \"Photo was not clear enough to identify the battery model.\",\n    reply_type: \"human_review\",\n    status: \"escalated\",\n    message: reply,\n    reply\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        368
      ],
      "id": "wf3-vision-unclear",
      "name": "Vision Unclear Result"
    },
    {
      "parameters": {
        "jsCode": "const ims = $input.first().json || {};\nlet vision = {};\ntry {\n  vision = $('Parse Code in js').first().json.output || {};\n} catch (e) {\n  vision = ims.output || {};\n}\nconst confidence = Number(vision.confidence ?? ims.confidence);\nconst model = vision.likely_model || ims.likely_model || ims.model || null;\nconst extracted = vision.extracted_text || ims.extracted_text || null;\nconst reply = ims.message || ims.reply || ims.text || \"We found a matching battery from your photo.\";\nreturn [{\n  json: {\n    ...ims,\n    confidence: Number.isFinite(confidence) ? confidence : 0,\n    likely_model: model,\n    model,\n    extracted_text: extracted,\n    reply_type: ims.reply_type || \"quotation\",\n    status: ims.status || \"success\",\n    message: reply,\n    reply\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        16
      ],
